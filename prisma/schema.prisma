generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(cuid())
  fullName     String
  email        String          @unique
  phone        String?
  passwordHash String?
  role         Role            @default(CUSTOMER)
  status       UserStatus      @default(ACTIVE)
  warehouseId  String?
  hubId        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  addresses    Address[]
  cart         Cart?
  courier      Courier?
  orders       Order[]
  returns      Return[]
  reviews      Review[]
  scans        ScanEvent[]
  sessions     Session[]
  movements    StockMovement[]
  hub          Hub?            @relation(fields: [hubId], references: [id])
  warehouse    Warehouse?      @relation(fields: [warehouseId], references: [id])
  vendor       Vendor?
  wishlist     WishlistItem[]
}

/// Login session. Only a SHA-256 hash of the cookie token is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  tagline   String
  imageUrl  String?
  sortOrder Int       @default(0)
  products  Product[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  logoUrl  String?
  products Product[]
}

model Vendor {
  id                String       @id @default(cuid())
  userId            String       @unique
  businessName      String
  gstin             String?
  commissionPercent Float        @default(12)
  status            VendorStatus @default(PENDING)
  storeDescription  String?
  pickupAddress     String?
  rejectionReason   String?
  approvedAt        DateTime?
  approvedById      String?
  createdAt         DateTime     @default(now())
  products          Product[]
  user              User         @relation(fields: [userId], references: [id])
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String
  description      String
  categoryId       String
  brandId          String
  vendorId         String
  mrp              Int
  sellingPrice     Int
  ratingAvg        Float            @default(0)
  ratingCount      Int              @default(0)
  isFeatured       Boolean          @default(false)
  isNewArrival     Boolean          @default(false)
  status           ProductStatus    @default(ACTIVE)
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  brand            Brand            @relation(fields: [brandId], references: [id])
  category         Category         @relation(fields: [categoryId], references: [id])
  vendor           Vendor           @relation(fields: [vendorId], references: [id])
  images           ProductImage[]
  specs            ProductSpec[]
  variants         ProductVariant[]
  reviews          Review[]
  wishlistedBy     WishlistItem[]

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSpec {
  id        String  @id @default(cuid())
  productId String
  key       String
  value     String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

/// Each variant is one SKU (size / colour option)
model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  sku           String          @unique
  label         String
  priceOverride Int?
  weightGrams   Int?
  cartItems     CartItem[]
  inventory     Inventory[]
  orderItems    OrderItem[]
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements     StockMovement[]
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderItemId String?
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Warehouse {
  id         String          @id @default(cuid())
  name       String
  code       String          @unique
  city       String
  address    String
  pincode    String
  isActive   Boolean         @default(true)
  /// First hub a parcel travels to after leaving this warehouse
  firstHubId String?
  inventory  Inventory[]
  shipments  Shipment[]
  movements  StockMovement[]
  users      User[]
  firstHub   Hub?            @relation("WarehouseFirstHub", fields: [firstHubId], references: [id])
}

model Hub {
  id                String        @id @default(cuid())
  name              String
  code              String        @unique
  type              HubType
  city              String
  pincode           String
  servicePincodes   String[]
  isOnline          Boolean       @default(true)
  /// Next hub on the line-haul route (null for a delivery hub)
  nextHubId         String?
  couriers          Courier[]
  nextHub           Hub?          @relation("HubRoute", fields: [nextHubId], references: [id])
  previousHubs      Hub[]         @relation("HubRoute")
  currentShipments  Shipment[]    @relation("ShipmentCurrentHub")
  deliveryShipments Shipment[]    @relation("ShipmentDeliveryHub")
  legs              ShipmentLeg[]
  users             User[]
  firstHubFor       Warehouse[]   @relation("WarehouseFirstHub")
}

/// Live stock buckets per SKU per warehouse
model Inventory {
  id                String         @id @default(cuid())
  variantId         String
  warehouseId       String
  available         Int            @default(0)
  reserved          Int            @default(0)
  picked            Int            @default(0)
  packed            Int            @default(0)
  shipped           Int            @default(0)
  lowStockThreshold Int            @default(8)
  updatedAt         DateTime       @updatedAt
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse      @relation(fields: [warehouseId], references: [id])

  @@unique([variantId, warehouseId])
}

/// Audit log of every stock bucket change
model StockMovement {
  id            String         @id @default(cuid())
  variantId     String
  warehouseId   String
  fromBucket    StockBucket
  toBucket      StockBucket
  quantity      Int
  reason        MovementReason
  referenceType String?
  referenceId   String?
  note          String?
  performedById String?
  createdAt     DateTime       @default(now())
  performedBy   User?          @relation(fields: [performedById], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])

  @@index([createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  userId          String
  /// Snapshot: { name, phone, line1, line2, city, state, pincode }
  shippingAddress Json
  subtotal        Int
  discountTotal   Int           @default(0)
  taxTotal        Int           @default(0)
  shippingFee     Int           @default(0)
  grandTotal      Int
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  status          OrderStatus   @default(PLACED)
  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  shipments       Shipment[]

  @@index([status])
}

model OrderItem {
  id                   String         @id @default(cuid())
  orderId              String
  variantId            String
  productName          String
  variantLabel         String
  sku                  String
  imageUrl             String?
  quantity             Int
  unitMrp              Int
  unitPrice            Int
  lineTotal            Int
  allocatedWarehouseId String?
  shipmentId           String?
  pickedQty            Int            @default(0)
  order                Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment             Shipment?      @relation(fields: [shipmentId], references: [id])
  variant              ProductVariant @relation(fields: [variantId], references: [id])
  returns              Return[]
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  method       PaymentMethod
  gateway      String?
  gatewayTxnId String?
  amount       Int
  status       TxnStatus     @default(INITIATED)
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds      Refund[]
}

/// One parcel. An order is split into one shipment per warehouse.
model Shipment {
  id               String            @id @default(cuid())
  shipmentNumber   String            @unique
  trackingNumber   String            @unique
  qrCode           String?           @unique
  deliveryOtp      String
  orderId          String
  warehouseId      String
  deliveryHubId    String?
  currentHubId     String?
  courierId        String?
  paymentType      PaymentType
  codAmount        Int               @default(0)
  status           ShipmentStatus    @default(ALLOCATED)
  labelGeneratedAt DateTime?
  dispatchedAt     DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  attempts         DeliveryAttempt[]
  items            OrderItem[]
  scans            ScanEvent[]
  courier          Courier?          @relation(fields: [courierId], references: [id])
  currentHub       Hub?              @relation("ShipmentCurrentHub", fields: [currentHubId], references: [id])
  deliveryHub      Hub?              @relation("ShipmentDeliveryHub", fields: [deliveryHubId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id])
  legs             ShipmentLeg[]

  @@index([status])
}

/// Planned route: one row per hub the parcel must pass through
model ShipmentLeg {
  id         String    @id @default(cuid())
  shipmentId String
  sequence   Int
  hubId      String
  status     LegStatus @default(PENDING)
  receivedAt DateTime?
  sortedAt   DateTime?
  departedAt DateTime?
  hub        Hub       @relation(fields: [hubId], references: [id])
  shipment   Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, sequence])
}

/// Every scan at pick, pack, label, handover, hub and doorstep
model ScanEvent {
  id            String    @id @default(cuid())
  shipmentId    String?
  returnId      String?
  type          ScanType
  locationLabel String
  scannedById   String?
  qrVerified    Boolean   @default(false)
  remarks       String?
  createdAt     DateTime  @default(now())
  return        Return?   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  scannedBy     User?     @relation(fields: [scannedById], references: [id])
  shipment      Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
}

model Courier {
  id            String            @id @default(cuid())
  userId        String            @unique
  zone          String
  vehicleNumber String
  homeHubId     String
  isAvailable   Boolean           @default(true)
  homeHub       Hub               @relation(fields: [homeHubId], references: [id])
  user          User              @relation(fields: [userId], references: [id])
  attempts      DeliveryAttempt[]
  returnPickups Return[]
  shipments     Shipment[]
}

model DeliveryAttempt {
  id            String        @id @default(cuid())
  shipmentId    String
  courierId     String
  attemptNumber Int
  status        AttemptStatus
  qrVerified    Boolean       @default(false)
  codCollected  Int           @default(0)
  podType       PodType?
  podValue      String?
  failureReason String?
  attemptedAt   DateTime      @default(now())
  courier       Courier       @relation(fields: [courierId], references: [id])
  shipment      Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Return {
  id                 String       @id @default(cuid())
  returnNumber       String       @unique
  orderItemId        String
  userId             String
  quantity           Int
  reason             String
  comment            String?
  status             ReturnStatus @default(REQUESTED)
  pickupCourierId    String?
  qcNotes            String?
  restockWarehouseId String?
  approvedById       String?
  approvedAt         DateTime?
  pickedUpAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  refunds            Refund[]
  orderItem          OrderItem    @relation(fields: [orderItemId], references: [id])
  pickupCourier      Courier?     @relation(fields: [pickupCourierId], references: [id])
  user               User         @relation(fields: [userId], references: [id])
  scans              ScanEvent[]
}

model Refund {
  id            String       @id @default(cuid())
  refundNumber  String       @unique
  orderId       String
  returnId      String?
  paymentId     String?
  amount        Int
  method        RefundMethod
  status        RefundStatus @default(INITIATED)
  reason        String?
  processedById String?
  createdAt     DateTime     @default(now())
  completedAt   DateTime?
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment       Payment?     @relation(fields: [paymentId], references: [id])
  return        Return?      @relation(fields: [returnId], references: [id])
}

/// Editable site settings (branding, theme, home content, store rules).
/// One row per key; anything missing falls back to the defaults in src/lib/settings.ts
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Sequence generator for human-readable numbers
model Counter {
  key   String @id
  value Int
}

enum Role {
  CUSTOMER
  VENDOR
  ADMIN
  WAREHOUSE
  HUB
  COURIER
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum VendorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  REJECTED
  INACTIVE
}

enum HubType {
  ORIGIN
  SORTING
  DELIVERY
}

enum StockBucket {
  NONE
  AVAILABLE
  RESERVED
  PICKED
  PACKED
  SHIPPED
}

enum MovementReason {
  RESTOCK
  ALLOCATION
  PICK
  PACK
  DISPATCH
  RETURN
  RELEASE
  ADJUSTMENT
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  COD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  ALLOCATED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum TxnStatus {
  INITIATED
  SUCCESS
  FAILED
}

enum ShipmentStatus {
  ALLOCATED
  PICKED
  PACKED
  LABELLED
  IN_TRANSIT
  AT_HUB
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum PaymentType {
  PREPAID
  COD
}

enum LegStatus {
  PENDING
  INBOUND
  RECEIVED
  SORTED
  DEPARTED
}

enum ScanType {
  PICK
  PACK
  LABEL
  HANDOVER
  HUB_INTAKE
  HUB_SORT
  HUB_DISPATCH
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RETURN_PICKUP
  RETURN_QC
}

enum AttemptStatus {
  DELIVERED
  FAILED
}

enum PodType {
  OTP
  PHOTO
  SIGNATURE
}

enum ReturnStatus {
  REQUESTED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  QC_PASSED
  QC_FAILED
}

enum RefundStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum RefundMethod {
  ORIGINAL_SOURCE
  BANK_TRANSFER
}
